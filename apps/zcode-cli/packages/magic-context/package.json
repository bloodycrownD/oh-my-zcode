{
  "name": "@zcode/magic-context",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "smoke": "node scripts/smoke-storage.mjs",
    "test": "node scripts/test-config.mjs",
    "test:host": "node scripts/test-host.mjs",
    "test:transform": "node scripts/test-transform.mjs",
    "test:historian": "node scripts/test-historian.mjs",
    "test:all": "npm run build && npm run smoke && npm run test && npm run test:host && npm run test:transform && npm run test:historian",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "ai-tokenizer": "^1.0.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
