{
  "name": "@zcode/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./repl": {
      "types": "./dist/repl/node-repl-session.d.ts",
      "import": "./dist/repl/node-repl-session.js"
    },
    "./browser-client": {
      "types": "./dist/browser-client/index.d.ts",
      "import": "./dist/browser-client/index.js"
    },
    "./create-workflow-graph-bounds": {
      "types": "./dist/tool/handlers/create-workflow-graph-bounds.d.ts",
      "import": "./dist/tool/handlers/create-workflow-graph-bounds.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "test:prompt-language-context": "node --test scripts/test-prompt-language-context.mjs",
    "test:ask-question-display": "tsx --test scripts/test-ask-question-display.mjs",
    "test:subagent-sync-dispatch": "tsx --test scripts/test-subagent-sync-dispatch.mjs",
    "test:subagent-notification-resume-hint": "tsx --test scripts/test-subagent-notification-resume-hint.mjs",
    "test:error-payload-agentid-projection": "tsx --test scripts/test-error-payload-agentid-projection.mjs",
    "test:send-message-terminal-resume": "tsx --test scripts/test-send-message-terminal-resume.mjs",
    "test:session-persistence-dedupe": "tsx --test scripts/test-session-persistence-dedupe.mjs",
    "test:tool-media-stop-signal": "tsx --test scripts/test-tool-media-stop-signal.mjs",
    "test:subagent-cache-breakpoints": "tsx --test scripts/test-subagent-cache-breakpoints.mjs",
    "test:ctx-tool-descriptions": "tsx --test scripts/test-ctx-tool-descriptions.mjs",
    "test:ctx-search-memory": "tsx --test scripts/test-ctx-search-memory.mjs",
    "test:ctx-memory-archive": "tsx --test scripts/test-ctx-memory-archive.mjs",
    "test:promotion-lease": "tsx --test scripts/test-promotion-lease.mjs",
    "test:queue-item-delivery-toggle": "tsx --test scripts/test-queue-item-delivery-toggle.mjs",
    "test:magic-context-section": "node --test scripts/test-magic-context-prompt-section.mjs",
    "test:workflow-report-count": "node --test scripts/test-workflow-report-count.mjs",
    "test:magic-context-section-ctx-note": "node --test scripts/test-magic-context-section-ctx-note.mjs",
    "test:prompt-surface-tiering": "node --test scripts/test-prompt-surface-tiering.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --no-ignore",
    "lint:fix": "oxlint --fix src --no-ignore",
    "test:e2e-subagent-resume": "tsx --test scripts/test-e2e-subagent-resume.mjs",
    "test:model-creation-failure": "node --import tsx --test scripts/test-model-creation-failure.mjs"
  },
  "dependencies": {
    "@zcode/contracts": "workspace:*",
    "@zcode/dynamic-workflow": "workspace:*",
    "@zcode/magic-context": "workspace:*",
    "@zcode/shared": "workspace:*",
    "@zcode/shared-types": "workspace:*",
    "@zcode/zcode-cua": "workspace:*",
    "cheerio": "^1.0.0",
    "diff": "^9.0.0",
    "ipaddr.js": "1.9.1",
    "marked": "16.4.2",
    "meriyah": "^7.1.1",
    "unbash": "4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}
