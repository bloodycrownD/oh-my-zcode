{
  "name": "@zcode/bootstrap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ctx-commands": {
      "types": "./dist/ctx-commands/index.d.ts",
      "import": "./dist/ctx-commands/index.js"
    },
    "./v4-replay": {
      "types": "./dist/zcode-protocol-v4/replay.d.ts",
      "import": "./dist/zcode-protocol-v4/replay.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node ../../scripts/clean-dist.mjs",
    "test:magic-context": "node --test scripts/test-magic-context-turn-transform.mjs",
    "test:settle-background": "node --test scripts/test-settle-background.mjs",
    "test:mural-media-blocks": "node --test scripts/test-mural-media-blocks.mjs",
    "test:e2e-live-all": "node --test scripts/test-e2e-live-all.mjs",
    "test:magic-context-absent-event": "node --test scripts/test-magic-context-absent-event.mjs",
    "test:magic-context-historian": "node --test scripts/test-magic-context-historian.mjs",
    "test:magic-context-config-rpc": "node scripts/test-magic-context-config-rpc.mjs",
    "test:magic-context-memories-rpc": "node scripts/test-magic-context-memories-rpc.mjs",
    "test:magic-context-usage": "node --test scripts/test-magic-context-usage-projection.mjs",
    "test:turn-directory": "tsx --test scripts/test-turn-directory.mjs",
    "test:ask-question-projection": "tsx --test scripts/test-ask-question-projection.mjs",
    "test:queue-item-delivery-command": "tsx --test scripts/test-queue-item-delivery-command.mjs",
    "test:edit-retry": "tsx --test scripts/test-edit-retry.mjs",
    "test:edit-retry-model": "tsx --test scripts/test-edit-retry-model.mjs",
    "test:default-model-live": "tsx --test scripts/test-default-model-live.mjs",
    "test:model-live": "node --test scripts/test-model-live.mjs",
    "test:prompt-surface-toolset-hash": "node --test scripts/test-prompt-surface-toolset-hash.mjs",
    "test:subagent-live-model": "node --test scripts/test-subagent-live-model.mjs",
    "test:prompt-language-rpc": "node --test scripts/test-prompt-language-rpc.mjs",
    "test:session-mapper-parts": "tsx --test scripts/test-session-mapper-parts.mjs",
    "test:late-tool-input-guard": "node --import tsx --test scripts/test-late-tool-input-guard.mjs",
    "test:legacy-cli-provider-config-import": "node --test scripts/test-legacy-cli-provider-config-import.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src",
    "test:mc-section-zh": "node scripts/test-magic-context-section-zh.mjs",
    "test:publisher-buffer-clamp": "tsx --test scripts/test-publisher-buffer-clamp.mjs",
    "test:model-request-slim": "tsx --test scripts/test-model-request-slim.mjs",
    "test:dwf-read-narrowing": "tsx --test scripts/test-dwf-read-narrowing.mjs",
    "test:dwf-journal-contract": "tsx --test scripts/test-dwf-journal-contract.mjs",
    "test:attachment-preview-text-plain": "tsx --tsconfig ../../../../packages/ui/tsconfig.json --test scripts/test-attachment-preview-text-plain.mjs",
    "test:held-queue-routing": "tsx --test scripts/test-held-queue-routing.mjs",
    "test:mc-entry-identity-guard": "node --test scripts/test-mc-entry-identity-guard.mjs",
    "test:concurrent-turn-terminal-guard": "node --test scripts/test-concurrent-turn-terminal-guard.mjs"
  },
  "dependencies": {
    "@zcode/adapters": "workspace:*",
    "@zcode/contracts": "workspace:*",
    "@zcode/core": "workspace:*",
    "@zcode/dynamic-workflow": "workspace:*",
    "@zcode/dynamic-workflow-runtime": "workspace:*",
    "@zcode/i18n": "workspace:*",
    "@zcode/magic-context": "workspace:*",
    "@zcode/provider": "workspace:*",
    "@zcode/provider-node": "workspace:*",
    "@zcode/shared": "workspace:*",
    "diff": "^9.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/yazl": "^3.3.1",
    "@zcode/formal-proof": "workspace:*",
    "yazl": "^3.3.1"
  }
}
