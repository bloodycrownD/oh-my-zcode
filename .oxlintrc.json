{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": null,
  "categories": {},
  "rules": {
    "max-lines": ["error", { "max": 400, "skipBlankLines": true, "skipComments": true }]
  },
  "overrides": [
    {
      // 测试文件天然会堆叠大量场景与断言，继续复用生产代码的行数上限会造成误报，
      // 因此只对 test/spec 文件关闭 max-lines，避免放宽业务代码约束。
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": ["**/i18n/locales/*.ts"],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "settings": {
    "jsx-a11y": {
      "polymorphicPropName": null,
      "components": {},
      "attributes": {}
    },
    "next": {
      "rootDir": []
    },
    "react": {
      "formComponents": [],
      "linkComponents": [],
      "version": null,
      "componentWrapperFunctions": []
    },
    "jsdoc": {
      "ignorePrivate": false,
      "ignoreInternal": false,
      "ignoreReplacesDocs": true,
      "overrideReplacesDocs": true,
      "augmentsExtendsReplacesDocs": false,
      "implementsReplacesDocs": false,
      "exemptDestructuredRootsFromChecks": false,
      "tagNamePreference": {}
    },
    "vitest": {
      "typecheck": false
    }
  },
  "env": {
    "builtin": true
  },
  "globals": {},
  "ignorePatterns": [
    "dist-release",
    "packages/ui/src/components/ui",
    "packages/ui/src/components/ai-elements",
    ".agents/skills",
    "packages/formal-proof",
    "apps/zcode-cli",
    "docs/electron",
    // FORK (upstream-v3.15.1-backport Step1): 上游快照参考仓未跟踪但会随迭代切换版本，
    // 其源码不属于本仓 lint 范围，排除以免污染根计数（实测污染可达 790w/307e）。
    // FORK (upstream-v3.16-backport Step1): 实测 oxlint 的 glob 形式 ".reference/**" 不生效，
    // 只有目录形式才被识别，改写如下。
    ".reference",
    // 本地未跟踪工具目录（迭代过程产物，不入库），排除以免 max-lines 误报拖红根 lint。
    ".tools/**",
    // docs/ 是迭代文档与工作工件（PRD/spec/cache 脚本、上游 locale 快照等），非产品代码：
    // 其质量由各迭代流程自管，不参与产品 lint 门禁（含基线计数与 max-lines）。
    "docs/**"
  ]
}
